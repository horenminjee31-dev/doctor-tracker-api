# Copy to .env and fill in real values
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
# Origin of the Next.js app, used for CORS if you call the API directly
CLIENT_ORIGIN=http://localhost:3000
# Leave empty for same-origin proxying through Next.js rewrites (recommended).
# Set to "none" only when client and API are served from different sites.
COOKIE_SAMESITE=
# Set to "true" when the API is served over HTTPS on another domain
COOKIE_SECURE=false
# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=
